    {
        "id": "fcc98447c16c3949",
        "type": "function",
        "z": "281e0a510310e9c6",
        "name": "Create Setting",
        "func": "let modBusSettingMsg = null;\nlet normalSettingMsg = null;\nlet trayControlMessage = null;\nlet tray = flow.get('tray');\nif (tray == null) return [modBusSettingMsg,normalSettingMsg,trayControlMessage];\nif (tray[msg.payload.cube].hasOwnProperty('enabled'))\n{\n    if (tray[msg.payload.cube].enabled == 0)\n    {\n        return [null, null, null];\n    }\n}\n\nif (msg.payload.cube != 'trayControl')\n{\n    tray[msg.payload.cube].value = msg.payload.value;\n    normalSettingMsg = { topic: 'newData', payload: tray };\n}\n\nswitch (msg.payload.cube) \n{\n    case 'IOState':\n        modBusSettingMsg = { topic: msg.payload.cube, payload:{fc:6, unitid:1, address:1, quantity:1, value:msg.payload.value}};\n        break;\n    case 'powerOn':\n        modBusSettingMsg = { topic: msg.payload.cube, payload:{fc:6, unitid:1, address:2, quantity:1, value:msg.payload.value}};\n         break;\n    case 'rfOn':\n         modBusSettingMsg = { topic: msg.payload.cube, payload:{fc:6, unitid:1, address:3, quantity:1, value:msg.payload.value}};\n       break;\n    case 'resetAlarm':\n        modBusSettingMsg = { topic: msg.payload.cube, payload:{fc:6, unitid:1, address:4, quantity:1, value:msg.payload.value}};\n        break;\n    case 'resetAll':\n        modBusSettingMsg = { topic: msg.payload.cube, payload:{fc:6, unitid:1, address:5, quantity:1, value:msg.payload.value}};\n        break;\n    case 'alias':\n       break;\n    case 'trayControl':\n        switch(msg.payload.value)\n        {\n            case 0:\n                tray.trayControl.value = 0;\n                break;\n            case 1:\n                tray.trayControl.value = -1;\n                break;\n            case 2:\n                if (tray.trayControl.value > 0)\n                {\n                    tray.trayControl.value = 2;\n                    let trayProps  = flow.get('trayProps');\n                    node.warn(\"Asking for tray from database\");\n                    trayControlMessage =\n                    {\n                        topic: trayProps.box + '/tray/' + trayProps.type + '/' + trayProps.name + '/echo',\n                        payload: JSON.stringify({ topic: trayProps.box + '/tray/' + trayProps.type + '/' + trayProps.name + '/setting/echo' })\n                    };\n                }\n                break;\n            default:\n                tray.trayControl.value = 0;\n                break;\n        }\n        normalSettingMsg = { topic: 'newData', payload: tray };\n        break;\n    default:\n        break;\n}\nflow.set('settingInProgress', false);\nif (modBusSettingMsg != null) flow.set('settingInProgress', true);\nreturn [modBusSettingMsg,normalSettingMsg,trayControlMessage];\n",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
