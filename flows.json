    {
        "id": "47de6287cc26419f",
        "type": "function",
        "z": "281e0a510310e9c6",
        "name": "Save config file",
        "func": "let tray = flow.get('tray');\nif (tray == null) return null;\nif (tray[msg.payload.cube].hasOwnProperty('enabled'))\n{\n    if (msg.payload.hasOwnProperty('enabled'))\n    {\n        tray[msg.payload.cube].enabled = msg.payload.enabled;\n    }\n}\nlet cubeAlarm = tray[msg.payload.cube].alarm;\ncubeAlarm.limits.lolo = msg.payload.limits.lolo;\ncubeAlarm.limits.low  = msg.payload.limits.low;\ncubeAlarm.limits.high = msg.payload.limits.high;\ncubeAlarm.limits.hihi = msg.payload.limits.hihi;\nreturn { topic: 'newData', payload: tray };",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
